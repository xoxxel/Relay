{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Relay",
  "version": "0.1.0",
  "identifier": "com.relay.app",
  "build": {
    "beforeDevCommand": "npm --prefix desktop-panel run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm --prefix desktop-panel run build",
    "frontendDist": "../desktop-panel/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Relay",
        "width": 460,
        "height": 660,
        "minWidth": 380,
        "minHeight": 560,
        "resizable": true,
        "decorations": true,
        "transparent": false,
        "backgroundColor": "#0A0A0C"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
